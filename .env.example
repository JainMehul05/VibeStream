# VibeStream - Root Environment Variables Example
# Copy this to .env and fill in your values
# NEVER commit real .env files to version control

# =============================================================================
# BACKEND (Django on Vercel)
# =============================================================================
SECRET_KEY=your-django-secret-key-here
DEBUG=False
ALLOWED_HOSTS=vibestream-backend-api.vercel.app,localhost,127.0.0.1

# MongoDB Atlas
MONGO_DB_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGO_DB_NAME=emotion_based_music_db
MONGO_DB_USERNAME=
MONGO_DB_PASSWORD=

# JWT (shared with Modal inference service)
JWT_SIGNING_KEY=your-jwt-signing-key-here
JWT_ACCESS_TOKEN_DAYS=7
JWT_REFRESH_TOKEN_DAYS=14

# Modal Inference Service
MODAL_INFERENCE_URL=https://your-modal-app.modal.run
MODAL_SERVICE_TOKEN=your-modal-service-token-here

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://vibestream-app.vercel.app

# Passkeys / WebAuthn (RP ID = frontend domain, no scheme)
WEBAUTHN_RP_ID=vibestream-app.vercel.app
WEBAUTHN_RP_NAME=VibeStream
WEBAUTHN_EXPECTED_ORIGINS=https://vibestream-app.vercel.app
WEBAUTHN_CHALLENGE_TTL_SECONDS=300

# Redis Cache (optional - uses LocMemCache if not set)
CACHE_REDIS_URL=

# Sentry Error Monitoring (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_PII=False

# Metrics
METRICS_ENABLED=True
METRICS_COLLECTION=backend_metrics
METRICS_TTL_DAYS=30
ADMIN_METRICS_TOKEN=your-admin-metrics-token-here

# =============================================================================
# FRONTEND (React on Vercel)
# =============================================================================
REACT_APP_API_URL=https://vibestream-backend-api.vercel.app
REACT_APP_MODAL_API_URL=https://your-modal-app.modal.run
REACT_APP_SENTRY_DSN=

# =============================================================================
# MOBILE (React Native/Expo)
# =============================================================================
EXPO_PUBLIC_API_URL=https://vibestream-backend-api.vercel.app
EXPO_PUBLIC_MODAL_API_URL=https://your-modal-app.modal.run

# =============================================================================
# DEVELOPMENT OVERRIDES (for local development)
# =============================================================================
# MONGO_DB_URI=mongodb://localhost:27017/emotion_based_music_db
# MODAL_INFERENCE_URL=http://localhost:8001  # modal serve URL
# REACT_APP_API_URL=http://localhost:8000
# REACT_APP_MODAL_API_URL=http://localhost:8001
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_EXPECTED_ORIGINS=http://localhost:3000,http://localhost:3001
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# DEBUG=True